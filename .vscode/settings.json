{
  "github.copilot.enable": {
    "*": true,
    "yaml": true,
    "plaintext": true,
    "markdown": true,
    "javascript": true
  },
  "github.copilot.chat.welcomeMessage": "never",
  "github.copilot.editor.enableAutoCompletions": true,
  "files.associations": {
    "copilot-instructions.md": "markdown"
  },
  "search.exclude": {
    "**/node_modules": true,
    "constants.js": true
  },
  "files.exclude": {
    "**/node_modules": true
  }
}
